# Baby backend production environment
# DO NOT COMMIT THE REAL .env FILE.

BABY_ENV=production

# API
BABY_API_HOST=127.0.0.1
BABY_API_PORT=8787

# CORS
# Set to your real Cloudflare Pages/custom domain before production.
BABY_ALLOWED_ORIGINS=https://baby.example.com

# Execution safety
BABY_REAL_MONEY_EXECUTION=DISABLED
BABY_CANARY_MAX_NOTIONAL=1

# Scheduler
BABY_RESEARCH_SCHEDULER=ENABLED

# Execution quote validation
BABY_EXECUTION_QUOTE_MAX_AGE_SECONDS=180
BABY_EXECUTION_MAX_SPREAD_PERCENT=2.0

# Alpaca
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Add any existing Baby/OpenAI/provider secrets here.
# Keep them server-side only.

# Baby V15 subscriber email
BABY_EMAIL_ENABLED=DISABLED
BABY_SMTP_HOST=smtp-relay.brevo.com
BABY_SMTP_PORT=587
BABY_SMTP_USERNAME=
BABY_SMTP_PASSWORD=
BABY_SMTP_FROM_EMAIL=
BABY_SMTP_FROM_NAME=Baby Investor
BABY_EMAIL_VERIFICATION_MINUTES=30
