# Replace api-baby.example.com with your real API domain.

api-baby.example.com {
    encode gzip zstd

    reverse_proxy 127.0.0.1:8787

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        -Server
    }

    log {
        output file /var/log/caddy/baby-api.log
    }
}
