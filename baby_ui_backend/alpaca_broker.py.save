from __future__ import annotations
from pathlib import Path
from dotenv import load_dotenv
import os
import uuid
from dataclasses import asdict, dataclass
from datetime import datetime, timezone
from typing import Any

PROJECT_ROOT = Path(__file__).resolve().parents[1]
ENV_PATH = PROJECT_ROOT / ".env"
load_dotenv(dotenv_path=ENV_PATH, override=False)
CONFIRMATION_PHRASE = "EXECUTE ALPACA PAPER"


def utcnow() -> str:
    return datetime.now(timezone.utc).isoformat()


@dataclass
class BrokerStatus:
    provider: str = "ALPACA"
    environment: str = "PAPER"
    configured: bool = False
    connected: bool = False
    trading_blocked: bool | None = None
    account_number_masked: str | None = None
    equity: float | None = None
    cash: float | None = None
    buying_power: float | None = None
    currency: str | None = None
    last_checked_at: str | None = None
    error: str | None = None
    real_money_execution: str = "DISABLED"
    requires_explicit_confirmation: bool = True


class AlpacaPaperBroker:
    """Alpaca PAPER-only broker adapter.

    Safety invariant: this adapter always constructs TradingClient(..., paper=True).
    Live credentials/endpoints are intentionally unsupported here.
    """

    def __init__(self, client: Any | None = None):
        self.api_key = os.getenv("ALPACA_PAPER_API_KEY") or os.getenv("APCA_API_KEY_ID")
        self.secret_key = os.getenv("ALPACA_PAPER_SECRET_KEY") or os.getenv("APCA_API_SECRET_KEY")
        self._client = client

    @property
    def configured(self) -> bool:
        return bool(self._client is not None or (self.api_key and self.secret_key))

    def _get_client(self):
        if self._client is not None:
            return self._client
        if not self.configured:
            raise RuntimeError("Alpaca Paper is not configured. Add ALPACA_PAPER_API_KEY and ALPACA_PAPER_SECRET_KEY to .env.")
        try:
            from alpaca.trading.client import TradingClient
        except ImportError as exc:
            raise RuntimeError("alpaca-py is not installed. Run: pip install -r requirements-v8.txt") from exc
        # HARD SAFETY BOUNDARY: paper=True is not configurable from environment/UI.
        self._client = TradingClient(self.api_key, self.secret_key, paper=True)
        return self._client

    @staticmethod
    def _f(value):
        try:
            return float(value) if value is not None else None
        except (TypeError, ValueError):
            return None

    @staticmethod
    def _enum(value):
        return getattr(value, "value", value)

    def status(self) -> dict[str, Any]:
        out = BrokerStatus(configured=self.configured, last_checked_at=utcnow())
        if not self.configured:
            out.error = "NOT_CONFIGURED"
            return asdict(out)
        try:
            acct = self._get_client().get_account()
            account_number = str(getattr(acct, "account_number", "") or "")
            out.connected = True
            out.trading_blocked = bool(getattr(acct, "trading_blocked", False))
            out.account_number_masked = ("••••" + account_number[-4:]) if account_number else None
            out.equity = self._f(getattr(acct, "equity", None))
            out.cash = self._f(getattr(acct, "cash", None))
            out.buying_power = self._f(getattr(acct, "buying_power", None))
            out.currency = str(getattr(acct, "currency", "USD") or "USD")
        except Exception as exc:
            out.error = f"{type(exc).__name__}: {exc}"
        return asdict(out)

    def positions(self) -> list[dict[str, Any]]:
        rows = []
        for p in self._get_client().get_all_positions():
            rows.append({
                "symbol": str(getattr(p, "symbol", "")),
                "qty": self._f(getattr(p, "qty", None)),
                "avg_entry_price": self._f(getattr(p, "avg_entry_price", None)),
                "market_value": self._f(getattr(p, "market_value", None)),
                "cost_basis": self._f(getattr(p, "cost_basis", None)),
                "unrealized_pl": self._f(getattr(p, "unrealized_pl", None)),
                "unrealized_plpc": self._f(getattr(p, "unrealized_plpc", None)),
                "current_price": self._f(getattr(p, "current_price", None)),
            })
        return rows

    def orders(self, limit: int = 100) -> list[dict[str, Any]]:
        try:
            from alpaca.trading.requests import GetOrdersRequest
            from alpaca.trading.enums import QueryOrderStatus
            req = GetOrdersRequest(status=QueryOrderStatus.ALL, limit=min(max(int(limit), 1), 500), nested=True)
            orders = self._get_client().get_orders(filter=req)
        except Exception:
            # Fake clients in contract tests can expose get_orders() without SDK request classes.
            orders = self._get_client().get_orders()
        return [self._serialize_order(o) for o in orders]

    def submit_confirmed_order(
        self,
        *,
        symbol: str,
        side: str,
        quantity: float,
        order_type: str = "MARKET",
        limit_price: float | None = None,
        confirmation: str,
        client_order_id: str | None = None,
    ) -> dict[str, Any]:
        if confirmation != CONFIRMATION_PHRASE:
            raise PermissionError(f"Explicit confirmation required: {CONFIRMATION_PHRASE}")
        symbol = symbol.strip().upper()
        side = side.strip().upper()
        order_type = order_type.strip().upper()
        quantity = float(quantity)
        if not symbol or not symbol.replace(".", "").replace("-", "").isalnum():
            raise ValueError("invalid symbol")
        if side not in {"BUY", "SELL"}:
            raise ValueError("side must be BUY or SELL")
        if quantity <= 0:
            raise ValueError("quantity must be positive")
        if order_type not in {"MARKET", "LIMIT"}:
            raise ValueError("order_type must be MARKET or LIMIT")
        if order_type == "LIMIT" and (limit_price is None or float(limit_price) <= 0):
            raise ValueError("positive limit_price required for LIMIT order")

        client_order_id = client_order_id or f"baby-paper-{uuid.uuid4().hex[:20]}"
        try:
            from alpaca.trading.requests import MarketOrderRequest, LimitOrderRequest
            from alpaca.trading.enums import OrderSide, TimeInForce
            enum_side = OrderSide.BUY if side == "BUY" else OrderSide.SELL
            if order_type == "MARKET":
                request = MarketOrderRequest(symbol=symbol, qty=quantity, side=enum_side, time_in_force=TimeInForce.DAY, client_order_id=client_order_id)
            else:
                request = LimitOrderRequest(symbol=symbol, qty=quantity, side=enum_side, time_in_force=TimeInForce.DAY, limit_price=float(limit_price), client_order_id=client_order_id)
            order = self._get_client().submit_order(order_data=request)
        except ImportError as exc:
            raise RuntimeError("alpaca-py is not installed. Run: pip install -r requirements-v8.txt") from exc
        return self._serialize_order(order)

    def cancel(self, order_id: str) -> dict[str, Any]:
        self._get_client().cancel_order_by_id(order_id)
        return {"order_id": order_id, "status": "CANCEL_REQUESTED", "environment": "PAPER"}

    def _serialize_order(self, o: Any) -> dict[str, Any]:
        return {
            "id": str(getattr(o, "id", "")),
            "client_order_id": str(getattr(o, "client_order_id", "") or ""),
            "symbol": str(getattr(o, "symbol", "")),
            "side": str(self._enum(getattr(o, "side", ""))).upper(),
            "type": str(self._enum(getattr(o, "type", ""))).upper(),
            "time_in_force": str(self._enum(getattr(o, "time_in_force", ""))).upper(),
            "qty": self._f(getattr(o, "qty", None)),
            "filled_qty": self._f(getattr(o, "filled_qty", None)),
            "limit_price": self._f(getattr(o, "limit_price", None)),
            "filled_avg_price": self._f(getattr(o, "filled_avg_price", None)),
            "status": str(self._enum(getattr(o, "status", "UNKNOWN"))).upper(),
            "submitted_at": str(getattr(o, "submitted_at", "") or ""),
            "environment": "PAPER",
            "real_money": False,
        }
